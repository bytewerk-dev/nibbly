# Nibbly CMS - .htaccess
# Apache mod_rewrite required
#
# All routing logic lives in route.php — this file is language-agnostic
# and never needs to be edited when changing SITE_LANG_DEFAULT.

RewriteEngine On
Options -MultiViews

# ============================================
# Security - Protect sensitive files
# ============================================

# Deny access to config files
<FilesMatch "(?i)^(config\.php|smtp-config\.php)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Deny access to JSON content files, backups, and trash directories
RewriteRule ^(content|backups|tests|cli)/ - [F,L,NC]
RewriteRule (^|/)[^/]*-trash(/|$) - [F,L,NC]
# Never expose VCS, environment or local tooling files. Keep ACME available.
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L,NC]

# Route news detail URLs before Apache can resolve language-local
# listing templates such as de/news.php or es/news.php.
RewriteRule ^([a-z]{2}/)?news/[a-z0-9-]+/?$ /route.php [END,QSA]

# ============================================
# Static files & directories
# ============================================

# Serve existing files directly (CSS, JS, images, fonts, etc.)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Serve directories that have an index.php (e.g. /admin/)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.php -f
RewriteRule ^ - [L]

# Clean URLs: if slug.php exists as a file, serve it directly
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ /$1.php [END]

# ============================================
# Front Controller
# ============================================

# Everything else goes to route.php (language routing, news, JSON pages).
# Use an absolute target and END so requests below real language
# directories (/de/..., /es/...) cannot enter another per-directory
# rewrite round.
RewriteRule ^ /route.php [END,QSA]

# ============================================
# Error Pages
# ============================================
ErrorDocument 404 /404.php
ErrorDocument 410 /410.php
